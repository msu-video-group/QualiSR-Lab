{
    "datasets": [
        {
            "name": "QualiSR-Set120",
            "root": "dataset",
            "features_root": "features",
            "regressors": {
                "train": true,
                "validate": true,
                "test_size": 0.2
            }
        }
    ],
    "_dataset_directory_example": {
        "_comment": "Optional alternative dataset entry using absolute directories; copy this object into datasets and adjust the paths.",
        "name": "custom-dataset",
        "root": "/absolute/path/to/dataset",
        "features_root": "/absolute/path/to/features/custom-dataset",
        "regressors": {
            "train": false,
            "validate": true
        },
        "labels": "/absolute/path/to/dataset/labels.csv",
        "directories": {
            "hr": "/absolute/path/to/hr",
            "lr": "/absolute/path/to/lr",
            "sr": {
                "METHOD": "/absolute/path/to/sr/METHOD"
            },
            "refs": {
                "bicubic": "/absolute/path/to/ref/bicubic"
            },
            "heatmaps": {
                "METHOD": "/absolute/path/to/heatmaps/METHOD"
            }
        }
    },
    "references": {
        "enabled": true,
        "refs": [
            "bicubic",
            "span",
            "rlfn"
        ],
        "ref_dirs": {},
        "output_ext": ".png",
        "scale": 4,
        "overwrite": false,
        "strict": false
    },
    "features": {
        "enabled": true,
        "common": {
            "device": "auto",
            "strict": false,
            "embedding_reference": "bicubic",
            "profile": false,
            "profile_flops": false,
            "fr_metrics": [
                "psnr",
                "ssim",
                "lpips-vgg",
                "stlpips-vgg",
                "pieapp",
                "ahiq"
            ],
            "nr_metrics": [
                "musiq",
                "arniqa",
                "qalign",
                "unique",
                "paq2piq"
            ]
        },
        "groups": {
            "nr": {
                "enabled": true,
                "features": [
                    "nr"
                ],
                "output": "{features_root}/nr.csv",
                "profile_output": "{features_root}/profiling/nr_profile.csv"
            },
            "fr": {
                "enabled": true,
                "features": [
                    "fr"
                ],
                "output": "{features_root}/fr.csv",
                "profile_output": "{features_root}/profiling/fr_profile.csv"
            },
            "vgg": {
                "enabled": true,
                "features": [
                    "vgg"
                ],
                "output": "{features_root}/vgg.csv",
                "profile_output": "{features_root}/profiling/vgg_profile.csv"
            },
            "resnet": {
                "enabled": true,
                "features": [
                    "resnet"
                ],
                "output": "{features_root}/resnet.csv",
                "profile_output": "{features_root}/profiling/resnet_profile.csv"
            },
            "ref_vgg": {
                "enabled": false,
                "features": [
                    "ref-vgg"
                ],
                "output": "{features_root}/ref_vgg.csv",
                "profile_output": "{features_root}/profiling/ref_vgg_profile.csv"
            },
            "ref_resnet": {
                "enabled": false,
                "features": [
                    "ref-resnet"
                ],
                "output": "{features_root}/ref_resnet.csv",
                "profile_output": "{features_root}/profiling/ref_resnet_profile.csv"
            },
            "timm": {
                "enabled": false,
                "features": [
                    "timm"
                ],
                "timm_encoders": {
                    "convnext_tiny": "convnext_tiny",
                    "vit_base_patch16_224": "vit_base_patch16_224"
                },
                "output": "{features_root}/timm.csv",
                "profile_output": "{features_root}/profiling/timm_profile.csv"
            },
            "ref_timm": {
                "enabled": false,
                "features": [
                    "ref-timm"
                ],
                "timm_encoders": {
                    "convnext_tiny": "convnext_tiny",
                    "vit_base_patch16_224": "vit_base_patch16_224"
                },
                "output": "{features_root}/ref_timm.csv",
                "profile_output": "{features_root}/profiling/ref_timm_profile.csv"
            },
            "siglip": {
                "enabled": true,
                "features": [
                    "siglip"
                ],
                "output": "{features_root}/siglip.csv",
                "profile_output": "{features_root}/profiling/siglip_profile.csv"
            },
            "noise": {
                "enabled": true,
                "features": [
                    "gaussian",
                    "uniform"
                ],
                "output": "{features_root}/noise.csv",
                "profile_output": "{features_root}/profiling/noise_profile.csv"
            }
        }
    },
    "pca": {
        "enabled": true,
        "common": {
            "n_components": [
                5, 10, 25, 50, 75, 100
            ],
            "output_dir": "{features_root}/pca",
            "disable_auto_split": false,
            "split_seed": 42,
            "test_size": 0.2
        },
        "runs": [
            {
                "enabled": true,
                "input": "{features_root}/vgg.csv",
                "blocks": [
                    "vgg=vgg_"
                ],
                "output_template": "vgg_pca{n}.csv"
            },
            {
                "enabled": true,
                "input": "{features_root}/resnet.csv",
                "blocks": [
                    "resnet=resnet_"
                ],
                "output_template": "resnet_pca{n}.csv"
            },
            {
                "enabled": false,
                "input": "{features_root}/vgg.csv",
                "reference_input": "{features_root}/ref_vgg.csv",
                "blocks": [
                    "vgg=vgg_"
                ],
                "reference_blocks": [
                    "vgg=ref_vgg_"
                ],
                "output_template": "vgg_shared_pca{n}.csv",
                "reference_output_template": "ref_vgg_shared_pca{n}.csv"
            },
            {
                "enabled": false,
                "input": "{features_root}/resnet.csv",
                "reference_input": "{features_root}/ref_resnet.csv",
                "blocks": [
                    "resnet=resnet_"
                ],
                "reference_blocks": [
                    "resnet=ref_resnet_"
                ],
                "output_template": "resnet_shared_pca{n}.csv",
                "reference_output_template": "ref_resnet_shared_pca{n}.csv"
            }
        ]
    },
    "embedding_difference": {
        "enabled": false,
        "runs": [
            {
                "reference_input": "{features_root}/pca/ref_vgg_shared_pca5.csv",
                "sr_input": "{features_root}/pca/vgg_shared_pca5.csv",
                "blocks": [
                    "vgg_diff=vgg_pca_,vgg_pca_"
                ],
                "output": "{features_root}/vgg_diff_pca5.csv"
            },
            {
                "reference_input": "{features_root}/pca/ref_resnet_shared_pca5.csv",
                "sr_input": "{features_root}/pca/resnet_shared_pca5.csv",
                "blocks": [
                    "resnet_diff=resnet_pca_,resnet_pca_"
                ],
                "output": "{features_root}/resnet_diff_pca5.csv"
            }
        ]
    },
    "statistics": {
        "enabled": true,
        "output": "{features_root}/stats.csv",
        "profile": false,
        "profile_output": "{features_root}/profiling/stats_profile.csv",
        "percentiles": [
            5,
            95
        ],
        "area_thresholds": [
            0,
            0.5,
            0.75
        ]
    },
    "regressors": {
        "enabled": true,
        "make_plots": true,
        "config": {
            "seed": 42,
            "experiment_name": "baseline",
            "scale_features": true,
            "cross_validation": {
                "enabled": false,
                "n_splits": 5
            },
            "permutation_repeats": 10,
            "save_dataset_snapshot": true,
            "save_mean_correlations": true,
            "save_best_correlations": false,
            "profiling": {
                "regressors": false,
                "feature_profile_files": [],
                "feature_profiles": {}
            },
            "analysis": {
                "outliers": {
                    "enabled": false,
                    "top_n": 25,
                    "feature_z_threshold": 3.0
                },
                "feature_metrics": {
                    "enabled": false,
                    "features": [],
                    "target_bins": 5,
                    "rank_by": "mutual_info",
                    "top_n": 40
                },
                "feature_selection": {
                    "enabled": false,
                    "features": [],
                    "directions": [
                        "forward"
                    ],
                    "model": "ridge",
                    "model_params": {},
                    "metric": "srcc",
                    "max_features": 12,
                    "min_features": 1
                }
            },
            "correlation_metrics": {
                "enabled": true,
                "items": [
                    {
                        "label": "MUSIQ (NR)",
                        "feature": "nr",
                        "metric": "musiq",
                        "higher_is_better": true
                    },
                    {
                        "label": "LPIPS-VGG+GT (FR)",
                        "feature": "fr",
                        "metric": "lpips-vgg",
                        "reference": "gt",
                        "higher_is_better": false
                    },
                    {
                        "label": "ARNIQA (NR)",
                        "feature": "nr",
                        "metric": "arniqa",
                        "higher_is_better": true
                    }
                ]
            },
            "paths": {
                "plots_root": "plots"
            },
            "features": {
                "pca_n": 5,
                "include": [
                    "nr",
                    "fr",
                    "vgg",
                    "resnet"
                ],
                "include_stats": false,
                "stats_columns": [
                    "max",
                    "median",
                    "std",
                    "area00"
                ],
                "fr_refs": [
                    "rlfn"
                ],
                "exclude_columns": [
                    "qalign"
                ],
                "feature_files": {
                    "nr": "{features_root}/nr.csv",
                    "fr": "{features_root}/fr.csv",
                    "siglip": "{features_root}/siglip.csv",
                    "vgg": "{features_root}/pca/vgg_pca{pca_n}.csv",
                    "resnet": "{features_root}/pca/resnet_pca{pca_n}.csv",
                    "stats": "{features_root}/stats.csv"
                }
            },
            "models": {
                "randomforest": {
                    "enabled": true,
                    "params": {}
                },
                "xgb": {
                    "enabled": true,
                    "params": {}
                },
                "catboost": {
                    "enabled": true,
                    "params": {}
                },
                "gradientboosting": {
                    "enabled": false,
                    "params": {}
                },
                "lgbm": {
                    "enabled": false,
                    "params": {}
                },
                "linear": {
                    "enabled": false,
                    "params": {}
                },
                "ridge": {
                    "enabled": false,
                    "params": {}
                },
                "lasso": {
                    "enabled": false,
                    "params": {
                        "alpha": 0.001
                    }
                },
                "elasticnet": {
                    "enabled": false,
                    "params": {
                        "alpha": 0.001,
                        "l1_ratio": 0.5
                    }
                },
                "svr": {
                    "enabled": false,
                    "params": {}
                },
                "linear_svr": {
                    "enabled": false,
                    "params": {}
                },
                "mlp": {
                    "enabled": false,
                    "params": {}
                }
            },
            "pretty_names": {
                "features": {},
                "models": {},
                "metrics": {},
                "references": {},
                "families": {}
            },
            "plot": {
                "enabled": {
                    "importance": true,
                    "all_importances": true,
                    "shap": true,
                    "all_shap_importances": true,
                    "correlations": true,
                    "correlations_without_metrics": true,
                    "feature_correlations": true,
                    "feature_cross_correlation_matrix": true,
                    "prediction_scatter": true
                },
                "importance_figsize": [
                    6,
                    12
                ],
                "shap_figsize": [
                    8,
                    12
                ],
                "shap_kernel_fallback": true,
                "shap_kernel_background_samples": 32,
                "shap_kernel_max_samples": 100,
                "shap_kernel_nsamples": "auto",
                "aggregate_max_columns": 3,
                "correlation_figsize": [
                    12,
                    5
                ],
                "scatter_figsize": [
                    8.5,
                    5.5
                ],
                "scatter_point_size": 100,
                "feature_correlation_matrix_figsize": [
                    10,
                    10
                ],
                "max_feature_correlation_matrix_features": 300,
                "max_feature_correlation_matrix_labels": 45,
                "feature_correlation_matrix_label_font_size": 8,
                "dpi": 300,
                "font_size": 16,
                "bbox_inches": "tight",
                "pad_inches": 0.1,
                "save_svg": false
            }
        }
    }
}
